{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Marquez performance history",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "runs"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/run"
      }
    }
  },
  "$defs": {
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "gitRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "comparisonMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "candidate", "unit", "direction"],
      "properties": {
        "baseline": {
          "type": "number"
        },
        "candidate": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": ["lower", "higher", "context"]
        }
      }
    },
    "snapshotMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "direction"],
      "properties": {
        "value": {
          "type": "number"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": ["lower", "higher", "context"]
        }
      }
    },
    "comparisonScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "metrics"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "metrics": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/comparisonMetric"
          }
        }
      }
    },
    "snapshotScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "metrics"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "metrics": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/snapshotMetric"
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "baseline", "candidate", "scenarios"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "baseline": {
          "$ref": "#/$defs/revision"
        },
        "candidate": {
          "$ref": "#/$defs/revision"
        },
        "fixture": {
          "$ref": "#/$defs/fixture"
        },
        "correctnessGates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/comparisonScenario"
          }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "scenarios"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "fixture": {
          "$ref": "#/$defs/fixture"
        },
        "correctnessGates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/snapshotScenario"
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "recordedAt",
        "sourceRevision",
        "environment",
        "comparisons",
        "snapshots",
        "caveats"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "recordedAt": {
          "type": "string",
          "format": "date"
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["java", "postgresql", "databaseIsolation", "productionCapacityTest"],
          "properties": {
            "java": {
              "type": "string"
            },
            "postgresql": {
              "type": "string"
            },
            "databaseIsolation": {
              "type": "string"
            },
            "productionCapacityTest": {
              "type": "boolean"
            }
          }
        },
        "comparisons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/comparison"
          }
        },
        "snapshots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/snapshot"
          }
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
